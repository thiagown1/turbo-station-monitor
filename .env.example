# ─── Telemetry API Key ───
TELEMETRY_API_KEY=your-api-key-here

# ─── Ports ───
VERCEL_DRAIN_PORT=3001
GITHUB_WEBHOOK_PORT=3002
MOBILE_TELEMETRY_PORT=3003
PAGARME_WEBHOOK_PORT=3004

# ─── Vercel Drain ───
DRAIN_SECRET=your-vercel-drain-secret

# ─── GitHub Webhook ───
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
CI_FIX_MAX_ATTEMPTS=10
OPENCLAW_CLI=/home/openclaw/.npm-global/bin/openclaw
MONITOR_DEPLOY_TELEGRAM_TARGET=telegram:your-monitor-alert-chat

# ─── Alert Engine ───
ALERT_TELEGRAM_GROUP=telegram:-5102620169
# WhatsApp groups (support-copilot conversation ids). Empty string disables.
# Normal alerts group ("Notificações Turbo Station"):
ALERT_WHATSAPP_CONV=conv_jiuijxjtmnet23i9
# Urgent group ("Turbo Station + URGENTE") — cable-theft / temperature-fault alerts:
ALERT_URGENT_WHATSAPP_CONV=conv_i7ljlrvrmrl33ohs

# ─── Pagarme Status Webhook ───
PAGARME_STATUS_TELEGRAM_TARGET=telegram:-5250194812
PAGARME_WEBHOOK_SECRET=your-pagarme-webhook-secret

# ─── Node Environment ───
NODE_ENV=production

# ─── WhatsApp agent router (fail-closed until all three are configured) ───
AGENT_EVENT_BASE_URL=https://app.example.com
AGENT_EVENT_SECRET=replace-with-a-dedicated-random-secret
OPENROUTER_API_KEY=replace-with-openrouter-key
AGENT_VISION_MODEL=openai/gpt-4o-mini
# Used only when the provider response omits usage.cost.
AGENT_INPUT_USD_PER_MILLION=0
AGENT_OUTPUT_USD_PER_MILLION=0

# ─── Contador (inert until explicitly enabled) ───
CONTADOR_ENABLED=false
CONTADOR_GROUP_CONVERSATION_ID=
CONTADOR_NEXT_BASE_URL=https://app.example.com
CONTADOR_NEXT_SECRET=replace-with-the-energy-intake-secret
CONTADOR_INSTANCE=turbostation
CONTADOR_OPENCLAW_AGENT=contador
CONTADOR_OPENCLAW_MODEL=claude-cli/claude-opus-4-8
CONTADOR_CODEX_FALLBACK_ENABLED=false
CONTADOR_CODEX_FALLBACK_MODEL=gpt-5.6-sol
CONTADOR_CODEX_BIN=/home/openclaw/.npm-global/bin/codex
CONTADOR_CODEX_WORKSPACE=/home/openclaw/.openclaw/workspace-contador
CONTADOR_SESSION_ID=contador-contas
CONTADOR_HEARTBEAT_HOUR=8
CONTADOR_MONTHLY_DAY=3

# Personal approval for proposed receipt classifications. Independent opt-in;
# deploying the code leaves the current flow unchanged. The target must be a
# personal WhatsApp JID/number and its digits must also be in the sender allowlist.
CONTADOR_FINANCIAL_APPROVAL_ENABLED=false
CONTADOR_FINANCIAL_APPROVAL_OPERATOR_JID=
CONTADOR_FINANCIAL_APPROVAL_ALLOWED_SENDER_IDS=
CONTADOR_FINANCIAL_APPROVAL_TTL_MINUTES=15

# ─── Monitor API Secret (shared with dashboard) ───
MONITOR_API_SECRET=replace-with-a-dedicated-random-secret

# ─── Auto-rollback watchdog (safe default: observation only) ───
# Rollout phases: shadow | approval-required | catastrophic-auto
ROLLBACK_ROLLOUT_PHASE=shadow
# Separate activation boundary. Keep 0 until phase-3 approval after shadow evidence.
ROLLBACK_DIRECT_ENABLE=0
# Exact, short-lived release attestation produced by the release pipeline.
ROLLBACK_RELEASE_SAFETY_PATH=
# Proposal destination must be the owner's personal conversation, never a group.
ROLLBACK_PERSONAL_CONVERSATION_ID=
ROLLBACK_PERSONAL_APPROVER_JID=
# Comma-separated JIDs accepted by the trusted inbound adapter.
ROLLBACK_ALLOWED_APPROVER_IDS=
